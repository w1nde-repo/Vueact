{
  "name": "@winde/vueact",
  "version": "0.0.9-alpha.3",
  "description": "Vueact framework core",
  "repository": {
    "type": "git",
    "url": "https://github.com/winde/vueact"
  },
  "type": "module",
  "main": "./dist/vueact.cjs.js",
  "module": "./dist/vueact.esm.js",
  "browser": "./dist/vueact.global.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "test": "echo \"No tests yet\"",
    "update": "npm version patch --no-git-tag-version && npm publish",
    "update:alpha": "npm version prerelease --preid alpha --no-git-tag-version && npm publish --tag alpha",
    "update:rc": "npm version prerelease --preid rc --no-git-tag-version && npm publish --tag rc"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.59.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "license": "MIT"
}
